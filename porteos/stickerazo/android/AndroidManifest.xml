<?xml version="1.0" encoding="utf-8"?>
<!-- Stickerazo. Sin permisos de fotos ni de cámara: la galería es el selector de Android y la cámara es la app de
     cámara del teléfono (le prestamos una dirección para que guarde la foto). INTERNET: la comunidad (feed, publicar,
     perfiles); la página sale de la app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.stickerazo.app">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- (la vibracioncita al tocar: me gusta, publicar…) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- (Android 11+: para ver si está WhatsApp y preguntarle si ya tiene un pack) -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Tema"
        android:allowBackup="true"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".Inicio"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- los enlaces de la página para compartir un pack: stickerazo://pack/ID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stickerazo" android:host="pack" />
            </intent-filter>
        </activity>

        <!-- lo que lee WhatsApp (sólo WhatsApp: su permiso) -->
        <provider
            android:name=".Stickers"
            android:authorities="com.stickerazo.app.stickers"
            android:enabled="true"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />

        <!-- las fotos de paso (la de la cámara y las convertidas): no es pública -->
        <provider
            android:name=".Fotos"
            android:authorities="com.stickerazo.app.fotos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
