<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- La base del Info.plist de la app de iPhone/iPad. ios/armar_ipa.sh le agrega la versión, los íconos (el principal y
     los que se pueden elegir en Ajustes → Ícono de la app) y los datos del SDK con el que se armó. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>es</string>
	<key>CFBundleExecutable</key><string>JXMod</string>
	<key>CFBundleIdentifier</key><string>com.jxmod.app</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>JXMod</string>
	<key>CFBundleDisplayName</key><string>JXMod</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>2.9</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>CFBundleSupportedPlatforms</key><array><string>iPhoneOS</string></array>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>MinimumOSVersion</key><string>15.0</string>
	<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
	<key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
	<key>UILaunchScreen</key><dict/>
	<key>UIRequiresFullScreen</key><true/>
	<key>UIStatusBarHidden</key><true/>
	<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
	<key>UISupportedInterfaceOrientations~ipad</key><array><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
	<key>NSMicrophoneUsageDescription</key><string>Para el chat de voz por cercanía con tus amigos.</string>
	<key>NSCameraUsageDescription</key><string>Para sacar una foto y usarla en el juego (por ejemplo, de ícono o de logo).</string>
	<key>NSPhotoLibraryAddUsageDescription</key><string>Para guardar las fotos que sacás en el juego.</string>
	<key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoadsInWebContent</key><true/></dict>
	<key>ITSAppUsesNonExemptEncryption</key><false/>
</dict>
</plist>
