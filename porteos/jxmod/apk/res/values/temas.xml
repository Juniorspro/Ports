<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Oscuro, sin barra de título, pantalla completa; de fondo (ventana de arranque) el logo centrado -->
    <style name="TemaBase" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/fondo_inicio</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorPrimary">@color/fondo</item>
        <item name="android:colorPrimaryDark">#FF000000</item>
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
    </style>
    <!-- values-v27 le suma el recorte de cámara; values-v31, la pantalla de inicio de Android 12 -->
    <style name="TemaRecorte" parent="TemaBase" />
    <style name="TemaJXMod" parent="TemaRecorte" />
</resources>
