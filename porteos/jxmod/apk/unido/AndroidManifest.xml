<?xml version="1.0" encoding="utf-8"?>
<!-- JXMod: Inicio (sin pantalla) abre el juego (Web: el HTML en una WebView propia, con WebGL 2 —o WebGL 1 si el
     aparato no tiene 2—). minSdk/targetSdk y versión los pone armar_apk.py al enlazar. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jxmod.app"
    android:installLocation="auto">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- partida en la red local (Lan.java): ver el wifi y oír los anuncios de las partidas (broadcast) sin que el
         wifi los tire para ahorrar batería -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- acceso directo con tu logo en Android 7 (desde el 8 se pide al sistema, sin permiso) -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" android:maxSdkVersion="25" />
    <!-- micrófono: chat de voz por cercanía -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:label="JXMod"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/TemaJXMod"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="false"
        android:appCategory="game"
        android:isGame="true"
        android:resizeableActivity="false"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false"
        android:supportsRtl="true">

        <meta-data android:name="android.max_aspect" android:value="2.4" />

        <activity
            android:name=".Inicio"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:noHistory="true"
            android:excludeFromRecents="true" />

        <!-- el ícono de la app que se elige en Ajustes (como en Discord): una entrada al lanzador por ícono, prendida
             sólo la elegida (Web.java: iconoApp). La de fábrica es «Clásico» -->
        <activity-alias
            android:name=".IconoClasico"
            android:targetActivity=".Inicio"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoNoche"
            android:targetActivity=".Inicio"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_v_noche"
            android:roundIcon="@mipmap/ic_v_noche_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoDorado"
            android:targetActivity=".Inicio"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_v_dorado"
            android:roundIcon="@mipmap/ic_v_dorado_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoNeon"
            android:targetActivity=".Inicio"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_v_neon"
            android:roundIcon="@mipmap/ic_v_neon_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoRojo"
            android:targetActivity=".Inicio"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_v_rojo"
            android:roundIcon="@mipmap/ic_v_rojo_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoBlanco"
            android:targetActivity=".Inicio"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_v_blanco"
            android:roundIcon="@mipmap/ic_v_blanco_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoAzul"
            android:targetActivity=".Inicio"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_v_azul"
            android:roundIcon="@mipmap/ic_v_azul_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoVhs"
            android:targetActivity=".Inicio"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_v_vhs"
            android:roundIcon="@mipmap/ic_v_vhs_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".Web"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:resizeableActivity="false"
            android:windowSoftInputMode="adjustResize">
            <!-- «Volver a JXMod» de la página de inicio de sesión con Google (jxmod://cuenta): sólo trae la app al frente;
                 la sesión no viaja en el enlace, el juego la pide a la tienda con su verificador -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jxmod" android:host="cuenta" />
            </intent-filter>
        </activity>
    </application>
</manifest>
